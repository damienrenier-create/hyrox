// use prisma-8

enum Role {
  @@type("pg/text@1")
  MASTER_ADMIN = "MASTER_ADMIN"
  ADMIN = "ADMIN"
  GREFFIER = "GREFFIER"
  STUDENT = "STUDENT"
}

enum WodTemplate {
  @@type("pg/text@1")
  PYRAMIDE_CLASSIQUE = "PYRAMIDE_CLASSIQUE"
  RELAIS_SPRINT = "RELAIS_SPRINT"
}

model User {
  id          String       @id @default(uuid())
  role        Role         @default(STUDENT)
  name        String
  className   String?
  password    String?
  reliability Int          @default(0)

  createdAt   DateTime     @default(now())

  teams       TeamMember[]
  evaluations Evaluation[]
}

model Session {
  id        String      @id @default(uuid())
  wodType   WodTemplate
  isActive  Boolean     @default(true)
  settings  Json?
  createdAt DateTime    @default(now())

  teams           Team[]
  evaluations     Evaluation[]
  boatPlacements  BoatPlacement[]
}

model Team {
  id        String       @id @default(uuid())
  name      String
  sessionId String
  session   Session      @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  members     TeamMember[]
  scores      Score[]
  evaluations Evaluation[]
}

model TeamMember {
  id     String @id @default(uuid())
  teamId String
  userId String
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Evaluation {
  id           String   @id @default(uuid())
  session      Session  @relation(fields: [sessionId], references: [id])
  sessionId    String
  team         Team     @relation(fields: [teamId], references: [id])
  teamId       String
  evaluator    User     @relation("EvaluationsGiven", fields: [evaluatorId], references: [id])
  evaluatorId  String
  
  exerciseId   String
  repsObserved Int
  note         Int      @default(0) // 5(TB), 4(B), 3(S), 0(I), -1(TI)
  isValidated  Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([sessionId])
  @@index([teamId])
  @@index([evaluatorId])
}

model BoatPlacement {
  id           String   @id @default(uuid())
  session      Session  @relation(fields: [sessionId], references: [id])
  sessionId    String
  teamId       String
  exerciseId   String
  ownerId      String   // User ID ou "GHOST_DAMZER"
  createdAt    DateTime @default(now())

  @@index([sessionId])
  @@index([teamId])
}

model Score {
  id        String   @id @default(uuid())
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  points    Int
  createdAt DateTime @default(now())
}
