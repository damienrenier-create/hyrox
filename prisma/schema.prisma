// use prisma-8

enum Role {
  @@type("pg/text@1")
  MASTER_ADMIN = "MASTER_ADMIN"
  ADMIN = "ADMIN"
  GREFFIER = "GREFFIER"
  STUDENT = "STUDENT"
}

enum WodTemplate {
  @@type("pg/text@1")
  PYRAMIDE_CLASSIQUE = "PYRAMIDE_CLASSIQUE"
  RELAIS_SPRINT = "RELAIS_SPRINT"
  TOUCHE_COULE_HYROX = "TOUCHE_COULE_HYROX"
  FETE_FORAINE = "FETE_FORAINE"
  LEVEL = "LEVEL"
}

enum Visibility {
  @@type("pg/text@1")
  PUBLIC   = "PUBLIC"
  PRIVATE  = "PRIVATE"
  SECRET   = "SECRET"
}

enum Sex {
  @@type("pg/text@1")
  M = "M"
  F = "F"
}

enum FleetStatus {
  @@type("pg/text@1")
  PLACING = "PLACING"
  LOCKED = "LOCKED"
}

enum ShotPhase {
  @@type("pg/text@1")
  DURING_WOD = "DURING_WOD"
  POST_WOD = "POST_WOD"
}

model User {
  id                String       @id @default(uuid())
  role              Role         @default(STUDENT)
  name              String
  firstName         String?
  lastName          String?
  className         String?
  sex               Sex?
  dateOfBirth       DateTime?
  password          String?
  pinCode           String?
  profileVisibility Visibility   @default(PUBLIC)
  reliability       Int          @default(0)

  createdAt         DateTime     @default(now())

  teams           TeamMember[]
  evaluations     Evaluation[]
  refereeFleets   RefereeFleet[]
  shotsFired      Shot[]
  selfEvaluations SelfEvaluation[]
  refereeOf       SessionReferee[]
}

// Cycle pedagogique (Hyrox, Volley...) : cree/nomme par DAMZER dans la console. Un seul cycle "en cours".
model Cycle {
  id        String      @id @default(uuid())
  name      String
  order     Int         @default(0)
  isCurrent Boolean     @default(false)
  classes   Json?       // classes concernees par ce cycle (ex. ["5GTb","6GTa"]) ; null ou vide = toutes
  createdAt DateTime    @default(now())

  plans    CyclePlan[]
  sessions Session[]
}

// Seance-type planifiee dans un cycle (Pyramide, Fete Foraine...). isCurrent = "la seance de la semaine",
// celle qui s'ouvre automatiquement pour une classe pendant son creneau horaire.
model CyclePlan {
  id          String      @id @default(uuid())
  cycle       Cycle       @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  cycleId     String
  wodType     WodTemplate
  label       String
  order       Int         @default(0)
  isCurrent   Boolean     @default(false)
  numTeams    Int         @default(24)
  refereeMode Boolean     @default(true)
  createdAt   DateTime    @default(now())

  sessions Session[]

  @@index([cycleId])
}

// Creneau horaire d'une classe (heure de Bruxelles) : weekday 1=lundi..5=vendredi, minutes depuis minuit.
// Depuis le journal de classe (23/09), chaque creneau appartient a un prof (teacherId = User.id d'un
// ADMIN/MASTER_ADMIN) : meme prof + meme debut/fin = un seul groupe (max 5 classes) = une seance commune.
// planId : seance-type imposee pour ce creneau ; null = la « seance de la semaine » du cycle en cours.
model ClassSlot {
  id        String  @id @default(uuid())
  className String
  weekday   Int
  startMin  Int
  endMin    Int
  teacherId String?
  planId    String?

  @@index([className])
  @@index([teacherId])
}

model Session {
  id          String      @id @default(uuid())
  wodType     WodTemplate
  isActive    Boolean     @default(true)
  refereeMode Boolean     @default(false) // Touche-Coule actif pour cette seance, independamment du wodType
  settings    Json?
  raceEndedAt DateTime?
  createdAt   DateTime    @default(now())
  // Rattachement au cycle / a la seance-type, ouverture manuelle ou automatique (voir src/lib/scheduling.ts)
  cycle       Cycle?      @relation(fields: [cycleId], references: [id])
  cycleId     String?
  plan        CyclePlan?  @relation(fields: [planId], references: [id])
  planId      String?
  label       String?
  slotKey     String?     @unique // "<date>_<planId>_<start>_<end>" : une seule ouverture auto par creneau
  opensAt     DateTime?   // seance PREPAREE a l'avance : invisible des eleves jusqu'a cette heure
  closesAt    DateTime?   // fin d'ouverture (fin du creneau, ou duree fixee a l'ouverture manuelle)
  autoOpened  Boolean     @default(false)
  teacherId   String?     // prof qui tient la seance (journal de classe ou ouverture manuelle) ; null = inconnu

  teams           Team[]
  evaluations     Evaluation[]
  boatPlacements  BoatPlacement[]
  refereeFleets   RefereeFleet[]
  shots           Shot[]
  raceState       RaceState?
  selfEvaluations SelfEvaluation[]
  referees        SessionReferee[]
  stationEvents   StationEvent[]
  levelTicks      LevelTick[]
  levelLosses     LevelLoss[]
  mineBoard       MineBoard?
  mineReveals     MineReveal[]
}

// Arbitres encodes par le greffier pour une seance, modifiable pendant tout le WOD :
// un participant qui abandonne (DNF, blessure...) garde ses resultats d'equipe et devient arbitre.
model SessionReferee {
  id        String   @id @default(uuid())
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  note      String?  // motif : Blessé(e) / Abandon (DNF) / Pas de tenue / Sanctionné(e) / Autre
  status    String   @default("APPROVED") // PENDING (demande de l'eleve) | APPROVED | REFUSED
  decidedBy String?  // pseudo/nom de qui a tranche (greffier, admin) — encodage direct = APPROVED d'office
  decidedAt DateTime?
  createdAt DateTime @default(now())

  @@unique([sessionId, userId])
  @@index([userId])
}

model Team {
  id              String       @id @default(uuid())
  name            String
  order           Int?         // position stable de l'equipe dans la grille (pour les bateaux verticaux)
  startExerciseId String?      // depart pyramide (override du round-robin par defaut)
  endExerciseId   String?      // dernier exercice termine (saisi apres la fin, pour une equipe non arrivee)
  color           String?      // Fete Foraine : macro-equipe jaune/vert/bleu/rouge (null = couleur par defaut selon l'ordre)
  penalties       Int          @default(0) // Fete Foraine : 1 penalite = 1 point (unite de temps)
  sessionId       String
  session         Session      @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  members     TeamMember[]
  scores      Score[]
  evaluations Evaluation[]
}

model TeamMember {
  id             String @id @default(uuid())
  teamId         String
  userId         String
  finisherPoints Int    @default(0) // Fete Foraine : points Finisher du coureur
  team           Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user           User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([userId])
}

// Fete Foraine : pointages du greffier (corde = repetable, exN = un seul, "fin" = Fin du WOD).
model StationEvent {
  id        String   @id @default(uuid())
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId String
  teamId    String
  stationId String
  at        DateTime @default(now())

  @@index([sessionId])
}

// Auto-evaluation d'un eleve participant, ouverte 24h apres la fin de son equipe / du WOD.
// answers = { [criterionId]: "TI"|"I"|"S"|"B"|"TB"|"E" } (voir wod-engines/core/self-eval.ts)
model SelfEvaluation {
  id          String   @id @default(uuid())
  session     Session  @relation(fields: [sessionId], references: [id])
  sessionId   String
  student     User     @relation(fields: [studentId], references: [id])
  studentId   String
  answers     Json
  submittedAt DateTime @default(now())

  @@unique([sessionId, studentId])
  @@index([sessionId])
}

// Regard du prof sur la seance d'un eleve : la meme grille que l'auto-evaluation, remplie par un admin,
// plus un commentaire libre. L'eleve ne voit chacun des deux que si l'admin l'a explicitement decide.
// Table separee de SelfEvaluation : le prof peut evaluer un eleve qui n'a jamais rendu la sienne.
model SelfEvalReview {
  id             String   @id @default(uuid())
  sessionId      String
  studentId      String
  answers        Json     // criterionId -> code (TI..E), memes criteres que l'auto-evaluation
  visible        Boolean  @default(false) // l'eleve voit la grille du prof
  comment        String?
  commentVisible Boolean  @default(false) // l'eleve voit le commentaire
  reviewerName   String   // nom affiche du prof (jamais son pseudo de connexion)
  updatedAt      DateTime @default(now())

  @@unique([sessionId, studentId])
  @@index([sessionId])
  @@index([studentId])
}

model Evaluation {
  id           String   @id @default(uuid())
  session      Session  @relation(fields: [sessionId], references: [id])
  sessionId    String
  team         Team     @relation(fields: [teamId], references: [id])
  teamId       String
  evaluator    User     @relation("EvaluationsGiven", fields: [evaluatorId], references: [id])
  evaluatorId  String
  
  exerciseId   String
  repsObserved Int
  note         Int      @default(0) // 5(TB), 4(B), 3(S), 0(I), -1(TI)
  isValidated  Boolean  @default(false)
  targetUserId String?  // WOD Level : eleve evalue individuellement (demineur) ; null = evaluation d'equipe
  createdAt    DateTime @default(now())

  shot Shot?

  @@index([sessionId])
  @@index([teamId])
  @@index([evaluatorId])
  @@index([targetUserId])
}

model BoatPlacement {
  id           String       @id @default(uuid())
  session      Session      @relation(fields: [sessionId], references: [id])
  sessionId    String
  teamId       String
  exerciseId   String
  ownerId      String       // legacy : User ID ou "GHOST_DAMZER" (conserve, plus utilisé pour l'ecriture)
  shipId       String?
  ship         RefereeShip? @relation(fields: [shipId], references: [id], onDelete: Cascade)
  createdAt    DateTime     @default(now())

  @@index([sessionId])
  @@index([teamId])
  @@index([sessionId, teamId, exerciseId])
}

model Score {
  id        String   @id @default(uuid())
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  points    Int
  createdAt DateTime @default(now())
}

model RefereeFleet {
  id         String      @id @default(uuid())
  session    Session     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId  String
  referee    User        @relation(fields: [refereeId], references: [id])
  refereeId  String
  slot       Int         @default(0)   // 0 = flotte reelle de l'arbitre ; >0 = flottes fantomes du meme User systeme
  status     FleetStatus @default(PLACING)
  lockedAt   DateTime?
  createdAt  DateTime    @default(now())

  ships RefereeShip[]

  @@unique([sessionId, refereeId, slot])
  @@index([sessionId])
}

model RefereeShip {
  id              String   @id @default(uuid())
  fleet           RefereeFleet @relation(fields: [fleetId], references: [id], onDelete: Cascade)
  fleetId         String
  size            Int
  orientation     String   // "horizontal" | "vertical"
  direction       String?  // sens de la proue : "right" | "left" | "down" | "up" (null = ancien placement, proue a droite/en bas)
  startTeamId     String
  startExerciseId String
  createdAt       DateTime @default(now())

  cells BoatPlacement[]

  @@index([fleetId])
}

model RaceState {
  id                 String    @id @default(uuid())
  session            Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId          String    @unique
  startedAt          DateTime?
  endedAt            DateTime?
  rep0               Int       @default(5)
  peak               Int       @default(10)
  step               Int       @default(1)
  runs               Int       @default(2)   // conserve pour export/fidelite ; jamais consomme par le calcul (deja mort dans le fichier d'origine)
  capMin             Int       @default(45)
  afterMin           Int       @default(10)
  penMin             Int       @default(1)
  noStartExerciseIds Json      @default("[]")
  createdAt          DateTime  @default(now())

  pauses RacePause[]
  laps   Lap[]
  cards  YellowCard[]
}

model RacePause {
  id          String    @id @default(uuid())
  raceState   RaceState @relation(fields: [raceStateId], references: [id], onDelete: Cascade)
  raceStateId String
  from        DateTime
  to          DateTime?

  @@index([raceStateId])
}

model Lap {
  id          String    @id @default(uuid())
  raceState   RaceState @relation(fields: [raceStateId], references: [id], onDelete: Cascade)
  raceStateId String
  teamId      String
  at          DateTime  @default(now())

  @@index([raceStateId, teamId])
}

model YellowCard {
  id          String    @id @default(uuid())
  raceState   RaceState @relation(fields: [raceStateId], references: [id], onDelete: Cascade)
  raceStateId String
  teamId      String
  at          DateTime  @default(now())

  @@index([raceStateId, teamId])
}

model Shot {
  id               String    @id @default(uuid())
  session          Session   @relation(fields: [sessionId], references: [id])
  sessionId        String
  referee          User      @relation(fields: [refereeId], references: [id])
  refereeId        String
  targetTeamId     String
  targetExerciseId String
  evaluation       Evaluation @relation(fields: [evaluationId], references: [id])
  evaluationId     String    @unique
  phase            ShotPhase
  createdAt        DateTime  @default(now())

  // Un arbitre n'evalue qu'une seule fois une case (equipe x atelier) d'une seance : regle de jeu,
  // garantie ici pour qu'un double-tap ou deux appareils ne puissent pas creer deux tirs.
  @@unique([sessionId, refereeId, targetTeamId, targetExerciseId])
  @@index([sessionId, targetTeamId, targetExerciseId])
  @@index([refereeId])
}

// ===== WOD LEVEL =====
// Catalogue d'exercices ponderes : weight = temps theorique d'une rep (secondes). Edite par les profs et le
// greffier depuis /admin/level. Un exercice desactive reste en base (les niveaux figes y font reference).
model LevelExercise {
  id        String   @id @default(uuid())
  label     String   @unique
  weight    Float
  active    Boolean  @default(true)
  order     Int      @default(0)
  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
}

// Echelle commune des niveaux, ordonnee par number (boss si number % 5 == 0).
// cards = [{ exerciseId, reps }] ; l'echelle est figee dans Session.settings.levels au coup d'envoi.
model Level {
  id        String   @id @default(uuid())
  number    Int      @unique
  name      String?
  cards     Json     @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
}

// Fiche cochee (greffier ou prof) pour une equipe : niveau + index de la fiche dans l'echelle figee.
// L'unicite rend le double-tap et deux profs qui cochent la meme fiche inoffensifs.
model LevelTick {
  id        String   @id @default(uuid())
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId String
  teamId    String
  level     Int
  card      Int
  by        String
  at        DateTime @default(now())

  @@unique([sessionId, teamId, level, card])
  @@index([sessionId])
}

// Demineur des arbitres (WOD Level) : une carte par seance — lignes = eleves, colonnes = exercices,
// mines = [[row, col]] — identique pour tous les arbitres, chacun ayant ses propres cases revelees.
model MineBoard {
  id        String   @id @default(uuid())
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId String   @unique
  rows      Json
  cols      Json
  mines     Json
  seed      String
  createdAt DateTime @default(now())
}

// Case revelee par un arbitre, adossee a l'evaluation individuelle encodee juste avant le « feu ».
model MineReveal {
  id           String   @id @default(uuid())
  session      Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId    String
  refereeId    String
  row          Int
  col          Int
  evaluationId String?  @unique
  at           DateTime @default(now())

  @@unique([sessionId, refereeId, row, col])
  @@index([sessionId])
}

// WOD Level, mode zombies : une vie perdue = le zombie a rattrape le coeur de l'equipe sur ce niveau.
// L'equipe retombe au niveau precedent (ses fiches des niveaux >= level-1 sont effacees) et le zombie repart.
model LevelLoss {
  id        String   @id @default(uuid())
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId String
  teamId    String
  level     Int
  at        DateTime @default(now())

  @@index([sessionId])
}
